{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "channel": "development"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "ios": {
        "simulator": false
      },
      "channel": "production"
    },
    "screenshots": {
      "distribution": "internal",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "channel": "screenshots"
    },
    "e2e": {
      "distribution": "internal",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_SENTRY_DSN": "off",
        "MAESTRO_RELEASE_BUILD": "true",
        "MAESTRO_CLI_NO_ANALYTICS": "1",
        "MAESTRO_DRIVER_STARTUP_TIMEOUT": "120000"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release",
        "config": "e2e-ios.yml"
      },
      "channel": "e2e"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6788117343"
      }
    }
  }
}
