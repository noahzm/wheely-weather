{
  "name": "wheely-weather",
  "main": "index.ts",
  "version": "1.0.0",
  "dependencies": {
    "@bacons/apple-targets": "~5.0.0",
    "@expo/ui": "~57.0.20",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.18",
    "@vitest/coverage-v8": "^5.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-unicorn": "^60.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "typescript": "$typescript",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "decode-uri-component": "^0.5.0",
    "@bacons/xcode": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "ios": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:clean": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo prebuild --clean --platform ios && npm run ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "lint": "expo lint -- --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:web",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "eas:build:ios-dev": "eas build --platform ios --profile development",
    "eas:build:ios-prod": "eas build --platform ios --profile production",
    "eas:build:android-dev": "eas build --platform android --profile development",
    "eas:build:android-prod": "eas build --platform android --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
