{
  "name": "wheely-weather",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "dependencies": {
    "@bacons/apple-targets": "~5.0.0",
    "@expo/ui": "~58.0.21",
    "@photostructure/tz-lookup": "^11.7.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~8.28.0",
    "expo": "~58.0.16",
    "expo-background-task": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.18",
    "expo-router": "~58.0.24",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^60.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "typescript": "$typescript",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "@bacons/xcode": {
      "@xmldom/xmldom": "^0.8.15"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo run:android",
    "ios": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios",
    "ios:clean": "cross-env SENTRY_DISABLE_AUTO_UPLOAD=true expo prebuild --clean --platform ios && npm run ios",
    "web": "cross-env EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "cross-env EXPO_NO_TELEMETRY=1 expo export --platform web",
    "typegen": "cross-env EXPO_NO_TELEMETRY=1 expo customize tsconfig.json",
    "lint": "npm run typegen && cross-env EXPO_NO_TELEMETRY=1 expo lint . --max-warnings 0",
    "typecheck": "npm run typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:web",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "e2e:ios": "cross-env MAESTRO_CLI_NO_ANALYTICS=1 maestro test .maestro",
    "eas:build:ios-dev": "eas build --platform ios --profile development",
    "eas:build:ios-prod": "eas build --platform ios --profile production",
    "eas:build:android-dev": "eas build --platform android --profile development",
    "eas:build:android-prod": "eas build --platform android --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
