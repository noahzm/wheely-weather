{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wheely-weather",
  "main": "workers/index.ts",
  // The dashboard exports first. Before deployment, run the same code/coverage
  // and Expo compatibility checks as CI, then verify that export. Browser smoke
  // tests run in GitHub CI, where Playwright's browser dependencies are installed.
  "build": { "command": "npm run check:deploy" },
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "wheelyweather.app", "custom_domain": true }],
  // Workers Logs: without it a failing /api/geocode proxy leaves nothing to inspect.
  "observability": { "enabled": true },
  // One shared object enforces Nominatim's app-wide one-request/second limit.
  "durable_objects": {
    "bindings": [{ "name": "GEOCODER", "class_name": "NominatimProxy" }],
  },
  "migrations": [{ "tag": "v1-geocoder", "new_sqlite_classes": ["NominatimProxy"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Match the previous Netlify behavior: unknown client-side routes fall back to /index.html.
    "not_found_handling": "single-page-application",
    // Assets are served before the Worker by default; the geocode proxy must win for /api/*.
    "run_worker_first": ["/api/*"],
  },
}
