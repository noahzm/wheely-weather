{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wheely-weather",
  "main": "workers/index.ts",
  // Runs before every `wrangler deploy`, so a failing unit test or a broken web
  // export stops Cloudflare's deploy (it runs on every push to main, separately
  // from GitHub CI). The dashboard runs `npm run build:web` first, so dist/ exists;
  // verify:web fails if any page ships without its JS bundle <script> tags.
  "build": { "command": "npm test && npm run verify:web" },
  "compatibility_date": "2026-06-01",
  "routes": [{ "pattern": "wheelyweather.app", "custom_domain": true }],
  // Workers Logs: without it a failing /api/geocode proxy leaves nothing to inspect.
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Match the previous Netlify behavior: unknown client-side routes fall back to /index.html.
    "not_found_handling": "single-page-application",
    // Assets are served before the Worker by default; the geocode proxy must win for /api/*.
    "run_worker_first": ["/api/*"],
  },
}
