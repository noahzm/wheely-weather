# Sentry crash/error reporting (src/services/telemetry.ts). Leave
# EXPO_PUBLIC_SENTRY_DSN unset to disable runtime reporting; the app
# runs fine without it. Set the real value in your gitignored .env.
EXPO_PUBLIC_SENTRY_DSN=

# Source maps upload only from EAS production builds, which have
# SENTRY_AUTH_TOKEN as an EAS secret. Local builds (npm run ios/android) and
# the development/preview EAS environments set SENTRY_DISABLE_AUTO_UPLOAD=true,
# so no token is needed here.
