{
  "expo": {
    "name": "Wheely Weather",
    "slug": "wheely-weather",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wheelyweather",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.wheelyweather",
      "appleTeamId": "Y2S6C64A97",
      "icon": "./assets/WheelyWeather.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.weatherkit": true,
        "com.apple.security.application-groups": ["group.app.wheelyweather"]
      }
    },
    "android": {
      "package": "app.wheelyweather",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F1BDF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      "./plugins/withCompilationCache.js",
      [
        "expo-router",
        {
          "origin": "https://wheelyweather.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F6",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wheely Weather to use your location for local cycling forecasts.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Wheely Weather does not use motion or fitness data. This permission string is required by a location library dependency."
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "organization": "noah-michaels",
          "project": "wheely-weather"
        }
      ],
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "buildCacheProvider": {
      "plugin": "expo/local-build-cache-provider"
    },
    "extra": {
      "eas": {
        "projectId": "ef6ed602-3db3-4a98-8498-52ad5442e138"
      }
    },
    "owner": "noahzm",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ef6ed602-3db3-4a98-8498-52ad5442e138"
    }
  }
}
